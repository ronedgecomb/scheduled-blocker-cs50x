{
  "manifest_version": 3,
  "name": "Scheduled Blocker",
  "version": "1.0.0",
  "description": "Blocks the websites you choose on the days and at the times you set.",
  "permissions": ["alarms", "storage", "tabs", "webNavigation"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Scheduled Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
